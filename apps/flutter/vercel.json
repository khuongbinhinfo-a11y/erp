{
  "version": 2,
  "framework": null,
  "buildCommand": "bash build-vercel.sh",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!assets/|canvaskit/|icons/|flutter_service_worker.js|flutter_bootstrap.js|flutter.js|main.dart.js|manifest.json).*)", "destination": "/index.html" }
  ]
}
